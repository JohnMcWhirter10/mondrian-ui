{
  "name": "mondrian-ui",
  "version": "0.1.0",
  "description": "A React component library with a style inspired by Piet Mondrian's neoplasticism, built with Radix UI primitives for enhanced accessibility and composability.",
  "author": "John Brea McWhirter",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JohnMcWhirter10/mondrian-ui.git"
  },
  "homepage": "https://github.com/JohnMcWhirter10/mondrian-ui#readme",
  "bugs": {
    "url": "https://github.com/JohnMcWhirter10/mondrian-ui/issues"
  },
  "main": "dist/mondrian-ui.cjs.js",
  "module": "dist/mondrian-ui.es.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/mondrian-ui.es.js",
      "require": "./dist/mondrian-ui.cjs.js"
    },
    "./style.css": "./dist/mondrian-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build",
    "test": "jest",
    "storybook": "npx storybook dev -p 6006",
    "build-storybook": "npx storybook build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "audit": "npm audit fix",
    "audit:fix": "npm audit fix --force",
    "lint:mondrian": "node src/utils/mondrianLintCheck.js",
    "lint:mondrian:ci": "node src/utils/mondrianLintCheck.js --exit-with-error"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-aspect-ratio": "^1.1.1",
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-navigation-menu": "^1.2.3",
    "@radix-ui/react-popover": "^1.1.5",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.5",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@radix-ui/react-visually-hidden": "^1.1.2"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-links": "^10.6.6",
    "@storybook/react": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/testing-library__react": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-storybook": "10.6.6",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.5.3",
    "storybook": "^10.6.6",
    "ts-jest": "^29.1.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2",
    "vite-plugin-dts": "^4.5.3"
  },
  "resolutions": {
    "rimraf": "^4.4.0",
    "esbuild": "^0.24.3"
  },
  "overrides": {
    "lodash.isequal": "^4.5.0",
    "lodash.get": "^4.4.2"
  }
}
